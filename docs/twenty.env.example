# Docker Compose template for crm/packages/twenty-docker/.env.
# Copy to that ignored path only after importing Twenty. Never copy root .env.
# Choose a tested release tag. Docker images do not automatically use crm/ edits.
TAG=TODO_TESTED_RELEASE_TAG
SERVER_URL=http://localhost:3000
PG_DATABASE_USER=postgres
# Generate a unique hex password locally: openssl rand -hex 32
PG_DATABASE_PASSWORD=TODO_GENERATE_UNIQUE_HEX_PASSWORD
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://redis:6379
STORAGE_TYPE=local
# Generate locally: openssl rand -base64 32
ENCRYPTION_KEY=TODO_GENERATE_UNIQUE_RANDOM_SECRET
# Set only when rotating an existing deployment's key:
# FALLBACK_ENCRYPTION_KEY=TODO_PREVIOUS_ENCRYPTION_KEY
# Legacy deployments only; see upstream migration guidance:
# APP_SECRET=TODO_LEGACY_APP_SECRET
