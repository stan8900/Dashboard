# Template for crm/packages/twenty-server/.env, using isolated flash services.
# Generate secrets locally; never commit the populated .env file.
NODE_ENV=development
PG_DATABASE_URL=postgres://postgres:TODO_GENERATED_HEX_PASSWORD@127.0.0.1:55432/default
REDIS_URL=redis://127.0.0.1:16379
APP_SECRET=TODO_GENERATED_RANDOM_SECRET
ENCRYPTION_KEY=TODO_GENERATED_RANDOM_SECRET
FRONTEND_URL=http://localhost:3001
SERVER_URL=http://localhost:3000
SIGN_IN_PREFILLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
STORAGE_TYPE=local
# Use an absolute flash-drive directory in the local .env:
STORAGE_LOCAL_PATH=TODO_ABSOLUTE_FLASH_STORAGE_PATH
IS_FDW_ENABLED=false
# This native development stack does not include ClickHouse.
ANALYTICS_ENABLED=false
CLICKHOUSE_URL=
