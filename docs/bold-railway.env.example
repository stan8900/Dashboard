# Set in Railway service variables; never commit populated credentials.
NODE_ENV=production
NODE_PORT=3000
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
SERVER_URL=https://TODO_BOLD_DOMAIN
FRONTEND_URL=https://TODO_BOLD_DOMAIN
APP_SECRET=TODO_GENERATED_RANDOM_SECRET
ENCRYPTION_KEY=TODO_GENERATED_RANDOM_SECRET
SIGN_IN_PREFILLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
IS_MULTIWORKSPACE_ENABLED=false
IS_BILLING_ENABLED=false
IS_FDW_ENABLED=false
ANALYTICS_ENABLED=false
STORAGE_TYPE=s3
STORAGE_S3_REGION=${{uploads.REGION}}
STORAGE_S3_NAME=${{uploads.BUCKET}}
STORAGE_S3_ENDPOINT=${{uploads.ENDPOINT}}
STORAGE_S3_ACCESS_KEY_ID=${{uploads.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{uploads.SECRET_ACCESS_KEY}}
STORAGE_S3_FORCE_PATH_STYLE=false
# Worker additionally uses:
# DISABLE_DB_MIGRATIONS=true
# DISABLE_CRON_JOBS_REGISTRATION=true
